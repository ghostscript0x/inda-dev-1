# ─── Required ──────────────────────────────────────────────────────────
# Postgres (Neon or Supabase). Use the pooled URL on Vercel. For a local Postgres use ?sslmode=disable.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) URL used only for migrations. Optional locally; set it on Vercel if DATABASE_URL is a pooled URL.
DIRECT_URL=""

# Public URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://inda.name.ng"

# Long random string (encrypts 2FA secrets). Generate: openssl rand -base64 48
AUTH_SECRET=""

# Random string Vercel Cron sends as "Authorization: Bearer <secret>". Generate: openssl rand -hex 32
CRON_SECRET=""

# Where sale, login, 404 and weekly-report alerts go.
ALERT_EMAIL="you@example.com"

# ─── Payments: Paystack (required to sell) ─────────────────────────────
# Test keys first (sk_test_…). The webhook URL to set in the Paystack dashboard:
#   https://inda.name.ng/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""

# ─── Files: Cloudinary (required in production) ────────────────────────
# Without it, uploads go to ./public/uploads and ./storage (local dev only).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# ─── Email: Resend (required in production) ────────────────────────────
# Without it, emails are printed to the server log (local dev only).
RESEND_API_KEY=""
EMAIL_FROM="inda.dev <hello@inda.name.ng>"

# ─── Spam protection: Cloudflare Turnstile (required in production) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Optional ──────────────────────────────────────────────────────────
# Max DB connections per server instance (default 10). Lower it on serverless if you hit connection limits.
DATABASE_POOL_MAX=""

# Rate limits shared across serverless instances (falls back to in-memory).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Telegram alerts in addition to email.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# `npm run db:seed` creates this admin if it doesn't exist yet (never resets an existing one).
# `npm run admin:create` also reads ADMIN_PASSWORD (otherwise it prompts).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
